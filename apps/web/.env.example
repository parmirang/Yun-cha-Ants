NEXT_PUBLIC_API_URL=http://localhost:4300

# GA4 측정 ID. 평소엔 안 건드려도 된다 — 기본값이 apps/web/src/app/layout.tsx에 박혀 있고,
# 개발 모드에서는 어차피 GA를 안 싣는다. 다른 속성으로 시험해볼 때만 여기에 넣는다.
# NEXT_PUBLIC_*은 빌드 때 번들에 박히므로 값을 바꾸면 재배포해야 한다.
# NEXT_PUBLIC_GA_ID=

# 링크 미리보기(og:image)를 절대 주소로 만들 때 쓰는 기준 주소. 비워두면 Vercel이
# 넣어주는 프로덕션 도메인을 쓰므로, 커스텀 도메인을 붙였을 때만 여기에 적는다.
# NEXT_PUBLIC_SITE_URL=https://example.com
